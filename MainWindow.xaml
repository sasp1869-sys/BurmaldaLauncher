<Window x:Class="BurmaldaLauncher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Burmalda Launcher" Height="680" Width="980"
 MinHeight="620" MinWidth="860" WindowStartupLocation="CenterScreen"
 Background="#FF0B0D14" Foreground="{StaticResource TextBrush}">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="#FF292D3D"/>
   <Setter Property="BorderBrush" Value="#665D8CFF"/>
   <Setter Property="Padding" Value="16,10"/>
   <Setter Property="Margin" Value="0,6,8,6"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="#FF10131D"/>
   <Setter Property="BorderBrush" Value="#665D8CFF"/>
   <Setter Property="Padding" Value="10,8"/>
   <Setter Property="FontSize" Value="14"/>
  </Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20">
   <StackPanel>
    <TextBlock Text="BURMALDA" FontSize="30" FontWeight="Bold" Foreground="#FFF7F8FF"/>
    <TextBlock Text="CLIENT LAUNCHER  •  FABRIC 1.21.1" Foreground="#FF9DA3B4" FontSize="12" Margin="2,3,0,0"/>
   </StackPanel>
   <Border DockPanel.Dock="Right" Background="#3325D7FF" BorderBrush="#885D8CFF" BorderThickness="1" CornerRadius="14" Padding="12,7" VerticalAlignment="Center">
    <TextBlock Text="LIQUID GLASS  /  RGB" Foreground="#FFB9DFFF" FontWeight="SemiBold"/>
   </Border>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" CornerRadius="22" Background="#CC171923" BorderBrush="#445D8CFF" BorderThickness="1" Padding="22" Margin="0,0,12,0">
    <StackPanel>
     <TextBlock Text="Установка клиента" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="Minecraft Java • 1.21.1 • Fabric" Foreground="#FF9DA3B4" Margin="0,5,0,18"/>
     <TextBlock Text="Папка игры" Foreground="#FF9DA3B4"/>
     <TextBlock x:Name="GamePathText" Text="Папка ещё не выбрана" TextWrapping="Wrap" Margin="0,5,0,10"/>
     <Button Content="Найти папку Minecraft" Click="ChooseFolder_Click"/>
     <Button Content="Установить JAR с компьютера" Click="InstallJar_Click" Background="#FF354B85"/>
     <Button Content="Открыть папку mods" Click="OpenMods_Click"/>
     <Separator Margin="0,18,0,14" Background="#445D8CFF"/>
     <TextBlock Text="Репозиторий обновлений" Foreground="#FF9DA3B4"/>
     <TextBox x:Name="ReleaseRepoText" Text="владелец/репозиторий" Margin="0,7,0,6"/>
     <Button Content="Проверить и установить обновление" Click="UpdateClient_Click" Background="#FF245C68"/>
     <TextBlock Text="В репозитории должен быть опубликован GitHub Release с JAR-файлом клиента." Foreground="#FF9DA3B4" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
    </StackPanel>
   </Border>
   <Border Grid.Column="1" CornerRadius="22" Background="#CC171923" BorderBrush="#4444D7FF" BorderThickness="1" Padding="24" Margin="12,0,0,0">
    <StackPanel>
     <TextBlock Text="Панель управления" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,18"/>
     <Border Background="#221FC8FF" CornerRadius="14" Padding="16" Margin="0,0,0,14">
      <StackPanel>
       <TextBlock Text="СТАТУС" Foreground="#FF9DA3B4" FontSize="11"/>
       <TextBlock x:Name="StatusText" Text="Ожидание действий" FontSize="18" Margin="0,5,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <TextBlock Text="Версия лаунчера" Foreground="#FF9DA3B4"/>
     <TextBlock Text="0.2.0 • Preview" FontSize="16" Margin="0,3,0,15"/>
     <TextBlock Text="Что уже умеет лаунчер" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="• Автоматически находит .minecraft&#10;• Устанавливает JAR в папку mods&#10;• Проверяет последний GitHub Release&#10;• Скачивает обновление и сохраняет резервную копию&#10;• Открывает папку модов" Foreground="#FFB9BECC" LineHeight="25" Margin="0,8,0,0"/>
     <TextBlock Text="Важно: запуск игры пока выполняется через твой Minecraft Launcher. Лаунчер не обходит авторизацию и не хранит пароль." Foreground="#FF9DA3B4" TextWrapping="Wrap" Margin="0,22,0,0"/>
    </StackPanel>
   </Border>
  </Grid>
  <TextBlock Grid.Row="2" Text="BURMALDA CLIENT  •  Сделано для Minecraft Java" Foreground="#FF777F92" HorizontalAlignment="Center" Margin="0,18,0,0"/>
 </Grid>
</Window>